{
  "name": "croft-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "tsc --noEmit && vite build --configLoader native",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview --configLoader native --host localhost"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "lucide-react": "1.72.0",
    "rbush": "4.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "wavesurfer.js": "8.1.0"
  },
  "devDependencies": {
    "@types/rbush": "4.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "vite": "7.3.8"
  },
  "overrides": {
    "vite": {
      "rollup": "npm:@rollup/wasm-node@4.68.3",
      "esbuild": "npm:esbuild-wasm@0.28.2"
    }
  }
}
